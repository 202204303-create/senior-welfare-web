# 이 파일을 .env 로 복사해서 사용하세요. (.env 는 Git 에 올리지 않습니다)

# Mock 데이터 사용 여부. 백엔드가 준비되면 false 로 바꾸세요. (기본값: true)
VITE_USE_MOCK=true

# 백엔드 API 주소 (VITE_USE_MOCK=false 일 때 사용)
VITE_API_BASE_URL=

# 카카오맵 JavaScript 키 (없으면 자체 간이 지도로 표시)
VITE_KAKAO_MAP_KEY=

# 소셜 로그인 (없으면 데모 로그인으로 동작)
VITE_KAKAO_REST_KEY=
VITE_NAVER_CLIENT_ID=

# Firebase (보호자 화면과 서버 저장). 비워 두면 기존처럼 이 기기(브라우저)에만 저장합니다.
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹)의 firebaseConfig 값을 넣으세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
