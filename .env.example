# 이 파일을 .env 로 복사해서 사용하세요. (.env 는 Git 에 올리지 않습니다)

# 소셜 로그인 (없으면 데모 로그인으로 동작)
VITE_KAKAO_REST_KEY=
VITE_NAVER_CLIENT_ID=

# Firebase (보호자 화면과 서버 저장)
# 비워 두면 팀 프로젝트(neulbom-c7096)를 씁니다. 다른 프로젝트를 쓸 때만 값을 넣으세요.
# 서버 없이 이 기기(브라우저)에만 저장하려면 VITE_FIREBASE_DISABLED=true
VITE_FIREBASE_DISABLED=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# 휴대폰 알림(화면이 꺼져 있어도): Firebase 콘솔 > 프로젝트 설정 > 클라우드 메시징 > 웹 푸시 인증서 공개 키
# 비워 두면 src/shared/api/push.ts 의 TEAM_VAPID_KEY 를 씁니다.
VITE_FIREBASE_VAPID_KEY=
